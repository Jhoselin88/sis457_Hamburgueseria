@model WebHamburgueseria.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-actualizar {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(25, 158, 55, 0.4);
    }

        .btn-actualizar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(25, 158, 55, 0.6);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(186, 46, 17, 0.4);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(186, 46, 17, 0.6);
            color: white;
        }

    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #783022 0%, #E02804 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px 25px;
        border: none;
    }

        .card-header h4 {
            margin: 0;
            font-weight: 600;
        }

            .card-header h4 i {
                margin-right: 10px;
            }

    .form-label {
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        transition: all 0.3s;
    }

        .form-control:focus, .form-select:focus {
            border-color: #ff6b35;
            box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
            outline: none;
        }

        .form-control[readonly] {
            background-color: #e9ecef;
            cursor: not-allowed;
        }

    .page-title {
        color: #2d3436;
    }

        .page-title i {
            color: #ff6b35;
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 5px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .badge-id {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 mb-1 page-title">
            <i class="fas fa-edit"></i>
            Editar Categoría
        </h1>
        <p class="text-muted mb-0">Modifique los datos de la categoría</p>
    </div>

    <!-- Formulario -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-tags"></i>
                        Información de la Categoría
                        <span class="badge-id float-right">ID: @Model.Id</span>
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <!-- Nombre -->
                        <div class="form-group">
                            <label asp-for="Nombre" class="form-label">
                                <i class="fas fa-tag text-muted mr-1"></i>
                                Nombre de la Categoría
                            </label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Hamburguesas, Bebidas, Postres..." />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <!-- Estado -->
                        <div class="form-group">
                            <label asp-for="Estado" class="form-label">
                                <i class="fas fa-toggle-on text-muted mr-1"></i>
                                Estado
                            </label>
                            <select asp-for="Estado" class="form-control form-select">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <!-- Botones -->
                        <div class="form-group mt-4 mb-0">
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <button type="submit" class="btn btn-actualizar btn-block">
                                        <i class="fas fa-sync-alt mr-2"></i>
                                        Actualizar Categoría
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a asp-action="Index" class="btn btn-cancelar btn-block">
                                        <i class="fas fa-times mr-2"></i>
                                        Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}