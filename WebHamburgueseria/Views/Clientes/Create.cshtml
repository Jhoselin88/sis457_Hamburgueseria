@model WebHamburgueseria.Models.Cliente
@{
    ViewData["Title"] = "Crear Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-guardar {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(25, 158, 55, 0.4);
    }

        .btn-guardar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(25, 158, 55, 0.6);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(186, 46, 17, 0.4);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(186, 46, 17, 0.6);
            color: white;
        }

    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #783022 0%, #E02804 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px 25px;
        border: none;
    }

        .card-header h4 {
            margin: 0;
            font-weight: 600;
        }

            .card-header h4 i {
                margin-right: 10px;
            }

    .form-label {
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        transition: all 0.3s;
    }

        .form-control:focus, .form-select:focus {
            border-color: #ff6b35;
            box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
            outline: none;
        }

    .page-title {
        color: #2d3436;
    }

        .page-title i {
            color: #ff6b35;
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 5px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 mb-1 page-title">
            <i class="fas fa-plus-circle"></i>
            Crear Nuevo Cliente
        </h1>
        <p class="text-muted mb-0">Complete el formulario para registrar un nuevo cliente</p>
    </div>

    <!-- Formulario -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h4>
                        Información del Cliente
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Cédula de Identidad -->
                        <div class="form-group">
                            <label asp-for="CedulaIdentidad" class="form-label">
                                Cédula de Identidad
                            </label>
                            <input asp-for="CedulaIdentidad" class="form-control" placeholder="Ej: 12345678" />
                            <span asp-validation-for="CedulaIdentidad" class="text-danger"></span>
                        </div>

                        <!-- Nombres -->
                        <div class="form-group">
                            <label asp-for="Nombres" class="form-label">
                                Nombres
                            </label>
                            <input asp-for="Nombres" class="form-control" placeholder="Ej: Juan Carlos" />
                            <span asp-validation-for="Nombres" class="text-danger"></span>
                        </div>

                        <!-- Apellidos -->
                        <div class="form-group">
                            <label asp-for="Apellidos" class="form-label">
                                Apellidos
                            </label>
                            <input asp-for="Apellidos" class="form-control" placeholder="Ej: Pérez López" />
                            <span asp-validation-for="Apellidos" class="text-danger"></span>
                        </div>

                        <!-- Usuario Registro -->
                        <div class="form-group">
                            <label asp-for="UsuarioRegistro" class="form-label">
                                Usuario de Registro
                            </label>
                            <input asp-for="UsuarioRegistro" class="form-control" placeholder="Usuario" />
                            <span asp-validation-for="UsuarioRegistro" class="text-danger"></span>
                        </div>

                        <!-- Fecha Registro -->
                        <div class="form-group">
                            <label asp-for="FechaRegistro" class="form-label">
                                Fecha de Registro
                            </label>
                            <input asp-for="FechaRegistro" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                        </div>


                        <!-- Botones -->
                        <div class="form-group mt-4 mb-0">
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <button type="submit" class="btn btn-guardar btn-block">
                                        <i class="fa fa-save"></i>
                                        Guardar Cliente
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a asp-action="Index" class="btn btn-cancelar btn-block">
                                        <i class="fa fa-times"></i>
                                        Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}