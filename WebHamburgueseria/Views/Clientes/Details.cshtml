@model WebHamburgueseria.Models.Cliente
@{
    ViewData["Title"] = "Detalles del Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-editar {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(25, 158, 55, 0.4);
    }

        .btn-editar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(25, 158, 55, 0.6);
            color: white;
        }

    .btn-volver {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(44, 62, 80, 0.4);
    }

        .btn-volver:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(44, 62, 80, 0.6);
            color: white;
        }

    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #783022 0%, #E02804 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px 25px;
        border: none;
    }

    .detail-row {
        padding: 20px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #2d3436;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .detail-value {
        font-size: 1.1rem;
        color: #636e72;
        font-weight: 500;
    }

    .badge-id {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1 page-title"><i class="fas fa-user"></i> Detalles del Cliente</h1>
        <p class="text-muted mb-0">Información completa del cliente</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-address-card"></i>
                        Cliente: @Model.Nombres @Model.Apellidos
                        <span class="badge-id float-right">ID: @Model.Id</span>
                    </h4>
                </div>

                <div class="card-body p-4">

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-id-card"></i> Cédula de Identidad</div>
                        <div class="detail-value">@Model.CedulaIdentidad</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user"></i> Nombres</div>
                        <div class="detail-value">@Model.Nombres</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user"></i> Apellidos</div>
                        <div class="detail-value">@Model.Apellidos</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user-shield"></i> Usuario Registro</div>
                        <div class="detail-value">@Model.UsuarioRegistro</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-calendar-alt"></i> Fecha Registro</div>
                        <div class="detail-value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-toggle-on"></i> Estado</div>
                        <div class="detail-value">
                            @if (Model.Estado == 1)
                            {
                                <span class="badge badge-estado badge-activo">
                                    <i class="fas fa-check-circle mr-1"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-estado badge-inactivo">
                                    <i class="fas fa-times-circle mr-1"></i> Inactivo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mt-4 pt-3">
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-editar btn-block">
                                    <i class="fas fa-edit mr-2"></i> Editar Cliente
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a asp-action="Index" class="btn btn-volver btn-block">
                                    <i class="fas fa-arrow-left mr-2"></i> Volver al Listado
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
