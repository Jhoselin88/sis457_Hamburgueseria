@model WebHamburgueseria.Models.DetalleVentas
@{
    ViewData["Title"] = "Eliminar Detalle de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Estilos personalizados para la vista de eliminación */
    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px;
    }

    .page-title {
        color: #2d3436;
        margin-bottom: 5px;
    }

        .page-title i {
            color: #BA2E11;
        }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #fff5db 100%);
        border-left: 4px solid #ffc107;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .detail-row {
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #6c757d;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1.1rem;
        color: #2d3436;
        font-weight: 500;
    }

    .badge-venta {
        background: linear-gradient(135deg, #783022, #a29bfe);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .badge-estado {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .badge-activo {
        background: linear-gradient(135deg, #00b894, #55efc4);
        color: white;
    }

    .badge-inactivo {
        background: linear-gradient(135deg, #6c757d, #adb5bd);
        color: white;
    }

    .btn-eliminar {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(186, 46, 17, 0.3);
    }

        .btn-eliminar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(186, 46, 17, 0.4);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(108, 117, 125, 0.3);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(108, 117, 125, 0.4);
            color: white;
        }

    .highlight-box {
        background: linear-gradient(135deg, #ffe8e8 0%, #fff0f0 100%);
        padding: 20px;
        border-radius: 12px;
        border-left: 4px solid #BA2E11;
    }

    .price-highlight {
        color: #BA2E11;
        font-size: 1.5rem;
        font-weight: 700;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 page-title">
            Eliminar Detalle de Venta
        </h1>
        <p class="text-muted mb-0">Confirmar eliminación del detalle de venta</p>
    </div>

    <!-- Alerta de advertencia -->
    <div class="alert-warning-custom">
        <h5 class="mb-2">
            <i class="fas fa-exclamation-triangle mr-2" style="color: #ffc107;"></i>
            ¿Está seguro que desea eliminar este detalle de venta?
        </h5>
        <p class="mb-0">Esta acción no se puede deshacer. Por favor, revise la información antes de confirmar.</p>
    </div>

    <!-- Detalles -->
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        Información del Detalle de Venta a Eliminar
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="row detail-row">
                        <div class="col-md-6">
                            <div class="detail-label">
                                <i class="fas fa-hamburger mr-1"></i>
                                Producto
                            </div>
                            <div class="detail-value">
                                @(Model.IdProductoNavigation?.Nombre ?? $"Producto #{Model.IdProducto}")
                            </div>
                        </div>
                    </div>

                    <div class="row detail-row">
                        <div class="col-md-4">
                            <div class="detail-label">
                                <i class="fas fa-boxes mr-1"></i>
                                Cantidad
                            </div>
                            <div class="detail-value">
                                @Model.Cantidad unidades
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="detail-label">
                                Precio Unitario
                            </div>
                            <div class="detail-value">
                                Bs. @Model.PrecioUnitario.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="highlight-box my-4">
                        <div class="detail-label">
                            Total
                        </div>
                        <div class="price-highlight">
                            Bs. @(Model.Total?.ToString("N2") ?? "0.00")
                        </div>
                    </div>

                    <div class="row detail-row">
                        <div class="col-md-6">
                            <div class="detail-label">
                                Usuario Registro
                            </div>
                            <div class="detail-value">
                                @Model.UsuarioRegistro
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-label">
                                Fecha Registro
                            </div>
                            <div class="detail-value">
                                @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm:ss")
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-cancelar">
                                <i class="fa fa-times mr-2"></i>
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-eliminar">
                                Confirmar Eliminación
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>