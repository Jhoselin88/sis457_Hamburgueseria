@model WebHamburgueseria.Models.Empleado
@{
    ViewData["Title"] = "Eliminar Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-eliminar {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(186, 46, 17, 0.4);
    }

        .btn-eliminar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(186, 46, 17, 0.6);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #636e72 0%, #2d3436 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(99, 110, 114, 0.4);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(99, 110, 114, 0.6);
            color: white;
        }

    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px 25px;
        border: none;
    }

        .card-header h4 {
            margin: 0;
            font-weight: 600;
        }

            .card-header h4 i {
                margin-right: 10px;
            }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
        border: 2px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

        .alert-warning-custom i {
            font-size: 2rem;
            color: #ff6b35;
        }

        .alert-warning-custom h5 {
            color: #856404;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .alert-warning-custom p {
            color: #856404;
            margin: 0;
            font-size: 0.95rem;
        }

    .detail-row {
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #636e72;
        font-size: 0.9rem;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
    }

        .detail-label i {
            color: #ff6b35;
            margin-right: 8px;
            width: 20px;
        }

    .detail-value {
        font-size: 1.05rem;
        color: #2d3436;
        font-weight: 500;
        padding-left: 28px;
    }

    .badge-estado {
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .badge-activo {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        color: white;
    }

    .badge-inactivo {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        color: white;
    }

    .badge-cargo {
        background: linear-gradient(135deg, #783022, #a29bfe);
        color: white;
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .page-title {
        color: #2d3436;
    }

        .page-title i {
            color: #BA2E11;
        }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 mb-1 page-title">
            <i class="fas fa-user-times"></i>
            Eliminar Empleado
        </h1>
        <p class="text-muted mb-0">Confirme la eliminación del empleado</p>
    </div>

    <!-- Alerta de Advertencia -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="alert-warning-custom">
                <div class="d-flex align-items-center">
                    <div>
                        <h5>¡Atención! Esta acción es irreversible</h5>
                        <p>¿Está seguro que desea eliminar este empleado? Esta acción no se puede deshacer.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card de Detalles -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-user-tie"></i>
                        Información del Empleado a Eliminar
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <!-- Columna Izquierda -->
                        <div class="col-md-6">
                            <div class="detail-row">
                                <div class="detail-label">
                                    Cédula de Identidad
                                </div>
                                <div class="detail-value">
                                    @Model.CedulaIdentidad
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Nombres
                                </div>
                                <div class="detail-value">
                                    @Model.Nombres
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Primer Apellido
                                </div>
                                <div class="detail-value">
                                    @(Model.PrimerApellido ?? "N/A")
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Segundo Apellido
                                </div>
                                <div class="detail-value">
                                    @(Model.SegundoApellido ?? "N/A")
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Celular
                                </div>
                                <div class="detail-value">
                                    @Model.Celular
                                </div>
                            </div>
                        </div>

                        <!-- Columna Derecha -->
                        <div class="col-md-6">
                            <div class="detail-row">
                                <div class="detail-label">
                                    Cargo
                                </div>
                                <div class="detail-value">
                                    <span class="badge-cargo">@Model.Cargo</span>
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Dirección
                                </div>
                                <div class="detail-value">
                                    @Model.Direccion
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Usuario de Registro
                                </div>
                                <div class="detail-value">
                                    @Model.UsuarioRegistro
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">
                                    Fecha de Registro
                                </div>
                                <div class="detail-value">
                                    @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Formulario y Botones -->
                    <form asp-action="Delete" class="mt-4 pt-3 border-top">
                        <input type="hidden" asp-for="Id" />
                        <div class="row">
                            <div class="col-md-6 mb-2 mb-md-0">
                                <button type="submit" class="btn btn-eliminar btn-block">
                                    Eliminar
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a asp-action="Index" class="btn btn-cancelar btn-block">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>