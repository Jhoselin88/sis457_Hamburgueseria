</div>

<!-- offer section Ordenado-->
<section class="offer_section layout_padding-bottom">
    <div class="offer_container">
        <div class="container ">
            <div class="row">

                <!-- Offer Box 1: Tasty Thursdays -->
                <div class="col-md-6  ">
                    <div class="box ">
                        <div class="img-box">
                            <img src="~/images/o1.jpg" alt="">
                        </div>
                        <div class="detail-box">
                            <h5>Jueves Sabrosos</h5>
                            <h6><span>20%</span> Off</h6>
                        </div>
                    </div>
                </div>

                <!-- Offer Box 2: Pizza Days -->
                <div class="col-md-6  ">
                    <div class="box ">
                        <div class="img-box">
                            <img src="~/images/o2.jpg" alt="">
                        </div>
                        <div class="detail-box">
                            <h5>Dias de Pizza</h5>
                            <h6><span>15%</span> Off</h6>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
<!-- end offer section -->
<!-- food section -->
<section class="food_section layout_padding-bottom">
    <div class="container">

        <!-- Heading -->
        <div class="heading_container heading_center">
            <h2>Menu 2</h2>
        </div>

        <!-- Filter Menu -->
        <ul class="filters_menu">
            <li class="active" data-filter="*">All</li>
            <li data-filter=".burger">Burger</li>
            <li data-filter=".pizza">Pizza</li>
            <li data-filter=".bebidas">Bebidas</li>
            <li data-filter=".fries">Fries</li>
        </ul>

        <!-- Menu Items Grid -->
        <div class="filters-content">
            <div class="row grid">

                <!-- Item 1: Delicious Pizza - $20 -->
                <div class="col-sm-6 col-lg-4 all pizza">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f1.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Pizza de Piña</h5>
                                <p>La pizza hawaiana es una pizza que contiene una base de salsa pomodoro, queso mozzarella fundido y como toppings jamón y piña.</p>
                                <div class="options">
                                    <h6>$20</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 2: Delicious Burger - $15 -->
                <div class="col-sm-6 col-lg-4 all burger">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f2.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Deliciosa Burger</h5>
                                <p>Hamburguesa de ternera, Lechuga, tomate y cebolla acompañada de patatas fritas.</p>
                                <div class="options">
                                    <h6>$15</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 3: Delicious Pizza - $17 -->
                <div class="col-sm-6 col-lg-4 all pizza">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f3.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Pizza Napolitana</h5>
                                <p>La clásica pizza napolitana, hecha con mozzarella fresca, tomates rojos brillantes, albahaca aromática y aceite de oliva virgen </p>
                                <div class="options">
                                    <h6>$17</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Item 5: French Fries - $10 -->
                <div class="col-sm-6 col-lg-4 all fries">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f5.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Papas Fritas</h5>
                                <p>Papas de buena calidad, fritas</p>
                                <div class="options">
                                    <h6>$10</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Item 5: French Fries - $15 -->
                <div class="col-sm-6 col-lg-4 all fries">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/salchi.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Salchichas</h5>
                                <p>Salchichas fritas para la salchipapa</p>
                                <div class="options">
                                    <h6>$15</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 6: Delicious Pizza - $15 -->
                <div class="col-sm-6 col-lg-4 all pizza">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f6.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Pizza Mixta</h5>
                                <p>Lleva 2 porciones de cada pizza que trae el menu</p>
                                <div class="options">
                                    <h6>$15</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 7: Tasty Burger - $12 -->
                <div class="col-sm-6 col-lg-4 all burger">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f7.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Burger de Pollo</h5>
                                <p>Pan especial, tomate, lechuga y pollo frito</p>
                                <div class="options">
                                    <h6>$12</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 8: Tasty Burger - $14 -->
                <div class="col-sm-6 col-lg-4 all burger">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="~/images/f8.png" alt="">
                            </div>
                            <div class="detail-box">
                                <h5>Burger Vegetariano</h5>
                                <p>Veniam debitis quaerat officiis quasi cupiditate quo, quisquam velit, magnam voluptatem repellendus sed eaque</p>
                                <div class="options">
                                    <h6>$14</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end food section -->
<!-- about section -->
<section class="about_section layout_padding">
    <div class="container  ">
        <div class="row">

            <!-- Image Column -->
            <div class="col-md-6 ">
                <div class="img-box">
                    <img src="~/images/about-img.png" alt="">
                </div>
            </div>

            <!-- Content Column -->
            <div class="col-md-6">
                <div class="detail-box">
                    <div class="heading_container">
                        <h2>Bendita Burger</h2>
                    </div>
                    <p>
                        En Bendita Burger preparamos hamburguesas hechas con ingredientes frescos y de la mejor calidad.
                        Cada bocado está pensado para ofrecerte sabor, textura y una experiencia única.
                        Ven y descubre por qué nuestras burgers son las favoritas de todos.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- end about section -->
<!-- book section -->
<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>
                Reserva una Mesa
            </h2>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form_container">
                    <form action="">
                        <div>
                            <input type="text" class="form-control" placeholder="Nombre" />
                        </div>
                        <div>
                            <input type="text" class="form-control" placeholder="Numero de celular" />
                        </div>
                        <div>
                            <input type="email" class="form-control" placeholder="Email" />
                        </div>
                        <div>
                            <select class="form-control nice-select wide">
                                <option value="" disabled selected>
                                    Cuantas Personas?
                                </option>
                                <option value="">1</option>
                                <option value="">2</option>
                                <option value="">3</option>
                                <option value="">4</option>
                                <option value="">5</option>
                            </select>
                        </div>
                        <div>
                            <input type="date" class="form-control">
                        </div>
                        <div class="btn_box">
                            <button>
                                Nueva Reserva
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-md-6">
                <div class="map_container ">
                    <div id="googleMap"></div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end book section -->