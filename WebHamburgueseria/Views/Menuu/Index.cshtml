                    <div class="box">
                        <div class="img-box">
                            <img src="~/images/f3.png" alt="Pizza Napolitana">
                            <div class="overlay">
                                <a href="#" class="btn-view">Ver Detalles</a>
                            </div>
                        </div>
                        <div class="detail-box">
                            <h5>Pizza Napolitana</h5>
