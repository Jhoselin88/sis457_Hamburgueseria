@{
    ViewData["Title"] = "Menu";
    ViewData["BodyClass"] = "sub_page";
}

<div class="hero_area">
    <div class="bg-box">
        <img src="~/images/hero-bg.jpg" alt="">
    </div>
</div>

<!-- food section -->
<section class="food_section layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Nuestro Menu</h2>
            <p>Descubre nuestras deliciosas opciones preparadas con ingredientes frescos</p>
        </div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">
                <i class="fa fa-cutlery"></i> Todos
            </li>
            <li data-filter=".burger">
                <i class="fa fa-certificate"></i> Hamburguesas
            </li>
            <li data-filter=".pizza">
                <i class="fa fa-pizza-slice"></i> Pizzas
            </li>
            <li data-filter=".fries">
                <i class="fa fa-spoon"></i> Acompañamientos
            </li>
        </ul>

        <!-- Menu Items Grid -->
        <div class="filters-content">
            <div class="row grid">

                <!-- Pizza de Piña - Bs. 20 -->
                <div class="col-sm-6 col-lg-3 all pizza">
                    <div class="box">
                        <div class="img-box">
                            <img src="~/images/f1.png" alt="Pizza de Piña">
                            <div class="overlay">
                                <a href="#" class="btn-view">Ver Detalles</a>
                            </div>
                        </div>
                        <div class="detail-box">
                            <h5>Pizza de Piña</h5>
                            <p>Pizza hawaiana con salsa pomodoro, mozzarella, jamón y piña.</p>
                            <div class="options">
                                <h6>Bs. 20</h6>
                                <a href="#" class="btn-add-cart" title="Agregar al carrito">
                                    <i class="fa fa-shopping-cart"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Deliciosa Burger - Bs. 15 -->
                <div class="col-sm-6 col-lg-3 all burger">
                    <div class="box">
                        <div class="img-box">
                            <img src="~/images/f2.png" alt="Deliciosa Burger">
                            <div class="overlay">
                                <a href="#" class="btn-view">Ver Detalles</a>
                            </div>
                        </div>
                        <div class="detail-box">
                            <h5>Deliciosa Burger</h5>
                            <p>Hamburguesa de ternera, lechuga, tomate y cebolla con papas fritas.</p>
                            <div class="options">
                                <h6>Bs. 15</h6>
                                <a href="#" class="btn-add-cart" title="Agregar al carrito">
