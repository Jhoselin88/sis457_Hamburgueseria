        <div class="btn-box text-center mt-5">
            <a asp-controller="Pages" asp-action="Book" class="btn btn-primary btn-lg">
                <i class="fa fa-calendar"></i> Reservar una Mesa
            </a>
        </div>
    </div>
</section>
<!-- end food section -->

<style>
    .food_section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 80px 0;
    }

    .heading_container {
        margin-bottom: 60px;
        text-align: center;
    }

        .heading_container h2 {
            color: #ffffff;
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .heading_container p {
            color: #ffffff;
            font-size: 18px;
            font-weight: 400;
        }

    .filters_menu {
        padding: 0;
        margin-bottom: 50px;
        list-style-type: none;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .filters_menu li {
            padding: 12px 30px;
            cursor: pointer;
            border-radius: 30px;
            background-color: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            font-weight: 600;
            font-size: 16px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

            .filters_menu li i {
                margin-right: 8px;
                font-size: 14px;
            }

            .filters_menu li:hover {
                background-color: #ffbe33;
                color: #222831;
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(255, 190, 51, 0.4);
                border-color: #ffbe33;
            }

            .filters_menu li.active {
                background-color: #ffbe33;
                color: #222831;
                border-color: #ffbe33;
                box-shadow: 0 8px 25px rgba(255, 190, 51, 0.4);
            }

    .food_section .box {
        background: linear-gradient(135deg, #222831 0%, #393E46 100%);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 25px rgba(0,0,0,0.3);
        margin-bottom: 30px;
        transition: all 0.4s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .food_section .box:hover {
            transform: translateY(-15px);
            box-shadow: 0 15px 45px rgba(0,0,0,0.2);
        }

    .food_section .img-box {
        width: 100%;
        height: 220px;
        position: relative;
        overflow: hidden;
        background-color: #f8f9fa;
    }

        .food_section .img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .food_section .box:hover .img-box img {
        transform: scale(1.15);
    }

    .food_section .img-box .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(34, 40, 49, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .food_section .box:hover .img-box .overlay {
        opacity: 1;
    }

    .btn-view {
        background-color: #ffbe33;
        color: #222831;
        padding: 12px 30px;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .btn-view:hover {
            background-color: #fff;
            color: #222831;
            transform: scale(1.05);
        }

    .food_section .detail-box {
        padding: 25px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

        .food_section .detail-box h5 {
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 12px;
            font-size: 20px;
            text-transform: capitalize;
        }

        .food_section .detail-box p {
            color: #f1f1f1;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 20px;
            flex-grow: 1;
            min-height: 45px;
        }

    .food_section .options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 15px;
        border-top: 2px solid #f1f1f1;
    }

        .food_section .options h6 {
            color: #ffbe33;
            font-size: 26px;
            font-weight: 800;
            margin: 0;
        }

    .btn-add-cart {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffbe33 0%, #ffa500 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #fff;
        transition: all 0.3s ease;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(255, 190, 51, 0.3);
    }

        .btn-add-cart:hover {
            background: linear-gradient(135deg, #222831 0%, #393E46 100%);
            color: #ffbe33;
            transform: scale(1.15) rotate(15deg);
            box-shadow: 0 6px 20px rgba(34, 40, 49, 0.4);
        }

        .btn-add-cart i {
            font-size: 18px;
        }

    .btn-primary {
        background: linear-gradient(135deg, #ffbe33 0%, #ffa500 100%);
        border: none;
        color: #fff;
        font-weight: 700;
        padding: 18px 50px;
        border-radius: 30px;
        font-size: 18px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 8px 25px rgba(255, 190, 51, 0.3);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #222831 0%, #393E46 100%);
            color: #ffbe33;
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(34, 40, 49, 0.4);
        }

        .btn-primary i {
            margin-right: 10px;
        }

    /* Responsive adjustments */
    @@media (max-width: 991px) {
        .food_section .box

    {
        margin-bottom: 30px;
    }

    .heading_container h2 {
        font-size: 32px;
    }

    }

    @@media (max-width: 767px) {
        .filters_menu

    {
        gap: 10px;
    }

    .filters_menu li {
        padding: 10px 20px;
        font-size: 14px;
    }

    .heading_container h2 {
        font-size: 28px;
    }

    .btn-primary {
        padding: 15px 35px;
        font-size: 16px;
    }

    }

    /* Animation on load */
    .filters-content {
        opacity: 0;
    }

        .filters-content.loaded {
            opacity: 1;
            animation: fadeIn 0.8s ease-in;
        }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

@section Scripts {
    <script>
        // Inicializar Isotope para filtros
        $(window).on('load', function () {
            var $grid = $('.filters-content');

            // Añadir clase loaded para animación
            $grid.addClass('loaded');

            // Inicializar Isotope
            $grid.isotope({
                itemSelector: '.all',
                percentPosition: false,
                masonry: {
                    columnWidth: '.all',
                    gutter: 0
                },
                layoutMode: 'fitRows'
            });

            // Bind filter button click
            $('.filters_menu li').on('click', function () {
                $('.filters_menu li').removeClass('active');
                $(this).addClass('active');

                var selector = $(this).attr('data-filter');
                $grid.isotope({
                    filter: selector
                });

                return false;
            });
        });

        // Animación suave al hacer scroll
        $(document).ready(function() {
            $('.filters_menu li').click(function(e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $('.filters-content').offset().top - 100
                }, 600);
            });
        });
    </script>
}