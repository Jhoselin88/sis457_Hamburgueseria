@model WebHamburgueseria.Models.Producto
@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-guardar {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(25, 158, 55, 0.4);
    }

        .btn-guardar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(25, 158, 55, 0.6);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(186, 46, 17, 0.4);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(186, 46, 17, 0.6);
            color: white;
        }

    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #783022 0%, #E02804 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px 25px;
        border: none;
    }

        .card-header h4 {
            margin: 0;
            font-weight: 600;
        }

            .card-header h4 i {
                margin-right: 10px;
            }

    .form-label {
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        transition: all 0.3s;
    }

        .form-control:focus, .form-select:focus {
            border-color: #ff6b35;
            box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
            outline: none;
        }

    .page-title {
        color: #2d3436;
    }

        .page-title i {
            color: #ff6b35;
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 5px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    /* Estilos para la carga de imagen */
    .image-upload-container {
        border: 3px dashed #ff6b35;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        background: #f8f9fa;
        transition: all 0.3s;
        cursor: pointer;
    }

        .image-upload-container:hover {
            background: #fff5f2;
            border-color: #E02804;
        }

    .image-upload-icon {
        font-size: 3rem;
        color: #ff6b35;
        margin-bottom: 15px;
    }

    .image-preview {
        max-width: 100%;
        max-height: 300px;
        border-radius: 12px;
        margin-top: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .file-input-label {
        color: #783022;
        font-weight: 600;
        margin-bottom: 10px;
    }

    #imagenFile {
        display: none;
    }

    .btn-seleccionar-imagen {
        background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
        margin-top: 10px;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-seleccionar-imagen:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.4);
        }

    .validation-errors {
        background: #fee;
        border: 1px solid #fcc;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .validation-errors h5 {
            color: #c33;
            margin-bottom: 10px;
        }

        .validation-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .validation-errors li {
            color: #c33;
        }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 mb-1 page-title">
            <i class="fas fa-plus-circle"></i>
            Nuevo Producto
        </h1>
        <p class="text-muted mb-0">Complete el formulario para registrar un nuevo producto</p>
    </div>

    <!-- Formulario -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-hamburger"></i>
                        Información del Producto
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.ValidationErrors != null)
                    {
                        <div class="validation-errors">
                            <h5><i class="fas fa-exclamation-triangle"></i> Errores de validación:</h5>
                            <ul>
                                @foreach (var error in ViewBag.ValidationErrors)
                                {
                                    <li><strong>@error.Field:</strong> @string.Join(", ", error.Errors)</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" name="Estado" value="1" />
                        <input type="hidden" name="Id" value="0" />

                        <!-- SECCIÓN DE IMAGEN -->
                        <div class="form-group">
                            <label class="form-label file-input-label">
                                <i class="fas fa-image"></i> Imagen del Producto
                            </label>
                            <div class="image-upload-container" onclick="document.getElementById('imagenFile').click()">
                                <i class="fas fa-cloud-upload-alt image-upload-icon"></i>
                                <p class="mb-2"><strong>Haz clic aquí para seleccionar una imagen</strong></p>
                                <p class="text-muted mb-0 small">Formatos aceptados: JPG, PNG, GIF (Máx. 5MB)</p>
                                <button type="button" class="btn-seleccionar-imagen" onclick="event.stopPropagation(); document.getElementById('imagenFile').click()">
                                    <i class="fas fa-folder-open"></i> Seleccionar Imagen
                                </button>
                            </div>
                            <input type="file"
                                   id="imagenFile"
                                   name="ImagenFile"
                                   accept="image/*"
                                   onchange="previewImage(event)" />
                            <div id="imagePreviewContainer" style="display: none; text-align: center;">
                                <img id="imagePreview" class="image-preview" alt="Vista previa" />
                                <p class="mt-2 text-success"><i class="fas fa-check-circle"></i> Imagen seleccionada</p>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Código -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Codigo" class="form-label">
                                        <i class="fas fa-barcode"></i> Código del Producto
                                    </label>
                                    <input asp-for="Codigo" class="form-control" placeholder="Ej: PROD001" required />
                                    <span asp-validation-for="Codigo" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Nombre -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Nombre" class="form-label">
                                        <i class="fas fa-hamburger"></i> Nombre del Producto
                                    </label>
                                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Hamburguesa Clásica" required />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Categoría -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="IdCategoria" class="form-label">
                                        <i class="fas fa-tags"></i> Categoría
                                    </label>
                                    <select asp-for="IdCategoria" class="form-control form-select" asp-items="ViewBag.IdCategoria" required>
                                        <option value="">-- Seleccione una categoría --</option>
                                    </select>
                                    <span asp-validation-for="IdCategoria" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Precio de Venta -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="PrecioVenta" class="form-label">
                                        <i class="fas fa-dollar-sign"></i> Precio de Venta (Bs.)
                                    </label>
                                    <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" required />
                                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Stock/Saldo -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Saldo" class="form-label">
                                        <i class="fas fa-boxes"></i> Stock Inicial
                                    </label>
                                    <input asp-for="Saldo" class="form-control" type="number" step="0.01" min="0" placeholder="0" value="0" />
                                    <span asp-validation-for="Saldo" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Usuario Registro -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="UsuarioRegistro" class="form-label">
                                        <i class="fas fa-user"></i> Usuario de Registro
                                    </label>
                                    <input asp-for="UsuarioRegistro" class="form-control" placeholder="Usuario" required />
                                    <span asp-validation-for="UsuarioRegistro" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Fecha Registro -->
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="FechaRegistro" class="form-label">
                                        <i class="fas fa-calendar-alt"></i> Fecha de Registro
                                    </label>
                                    <input asp-for="FechaRegistro" id="fechaRegistro" class="form-control" type="datetime-local" required />
                                    <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Descripción -->
                        <div class="form-group">
                            <label asp-for="Descripcion" class="form-label">
                                <i class="fas fa-align-left"></i> Descripción
                            </label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Descripción detallada del producto..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <!-- Botones -->
                        <div class="form-group mt-4 mb-0">
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <button type="submit" class="btn btn-guardar w-100">
                                        <i class="fa fa-save"></i>
                                        Guardar Producto
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a asp-action="Index" class="btn btn-cancelar w-100">
                                        <i class="fa fa-times"></i>
                                        Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Vista previa de imagen
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                // Validar tamaño (5MB máximo)
                if (file.size > 5 * 1024 * 1024) {
                    alert('La imagen es muy grande. El tamaño máximo es 5MB.');
                    event.target.value = '';
                    return;
                }

                // Validar tipo de archivo
                const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
                if (!validTypes.includes(file.type)) {
                    alert('Por favor selecciona una imagen válida (JPG, PNG, GIF)');
                    event.target.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        // Establecer la fecha y hora actual automáticamente
        document.addEventListener('DOMContentLoaded', function() {
            const fechaInput = document.getElementById('fechaRegistro');

            if (fechaInput && !fechaInput.value) {
                const now = new Date();
                const offset = now.getTimezoneOffset() * 60000;
                const localDate = new Date(now.getTime() - offset);
                const fechaISO = localDate.toISOString().slice(0, 16);

                fechaInput.value = fechaISO;
            }

            // Validación adicional del formulario
            const form = document.querySelector('form');
            form.addEventListener('submit', function(e) {
                const categoria = document.querySelector('select[name="IdCategoria"]');
                if (!categoria.value) {
                    e.preventDefault();
                    alert('Por favor seleccione una categoría');
                    categoria.focus();
                    return false;
                }

                const precio = document.querySelector('input[name="PrecioVenta"]');
                if (parseFloat(precio.value) <= 0) {
                    e.preventDefault();
                    alert('El precio debe ser mayor a 0');
                    precio.focus();
                    return false;
                }
            });
        });
    </script>
}