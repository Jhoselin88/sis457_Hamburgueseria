@model WebHamburgueseria.Models.Producto
@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-eliminar {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(186, 46, 17, 0.4);
    }

        .btn-eliminar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(186, 46, 17, 0.6);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(44, 62, 80, 0.4);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(44, 62, 80, 0.6);
            color: white;
        }

    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px 25px;
        border: none;
    }

        .card-header h4 {
            margin: 0;
            font-weight: 600;
        }

            .card-header h4 i {
                margin-right: 10px;
            }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
        border: 2px solid #ff6b35;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
    }

        .alert-warning-custom i {
            font-size: 2rem;
            color: #ff6b35;
            margin-right: 15px;
        }

        .alert-warning-custom h5 {
            color: #856404;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .alert-warning-custom p {
            color: #856404;
            margin-bottom: 0;
            font-weight: 500;
        }

    .detail-row {
        padding: 20px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #2d3436;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

        .detail-label i {
            color: #ff6b35;
            margin-right: 8px;
        }

    .detail-value {
        font-size: 1.1rem;
        color: #636e72;
        font-weight: 500;
    }

    .page-title {
        color: #2d3436;
    }

        .page-title i {
            color: #BA2E11;
        }

    .badge-estado {
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 1rem;
        font-weight: 500;
        display: inline-block;
    }

    .badge-activo {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        color: white;
    }

    .badge-inactivo {
        background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
        color: white;
    }

    .badge-id {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .badge-categoria {
        background: linear-gradient(135deg, #783022, #a29bfe);
        color: white;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 1rem;
        font-weight: 500;
        display: inline-block;
    }

    .precio-destacado {
        font-size: 1.8rem;
        color: #00b894;
        font-weight: 700;
    }

    .stock-destacado {
        font-size: 1.5rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 mb-1 page-title">
            <i class="fas fa-trash-alt"></i>
            Eliminar Producto
        </h1>
        <p class="text-muted mb-0">Confirme la eliminación del producto</p>
    </div>

    <!-- Tarjeta de eliminación -->
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Alerta de advertencia -->
            <div class="alert-warning-custom d-flex align-items-center">
                <i class="fas fa-exclamation-triangle"></i>
                <div>
                    <h5>¡Atención! Esta acción es irreversible</h5>
                    <p>¿Está seguro de que desea eliminar este producto? Todos los datos asociados se perderán permanentemente.</p>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h4>
                        <i class="fas fa-hamburger"></i>
                        Producto: @Model.Nombre
                        <span class="badge-id float-right">ID: @Model.Id</span>
                    </h4>
                </div>
                <div class="card-body p-4">

                    <div class="row">
                        <div class="col-md-6">
                            <!-- Código -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-barcode"></i>
                                    Código del Producto
                                </div>
                                <div class="detail-value">
                                    @Model.Codigo
                                </div>
                            </div>

                            <!-- Nombre -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-tag"></i>
                                    Nombre
                                </div>
                                <div class="detail-value">
                                    @Model.Nombre
                                </div>
                            </div>

                            <!-- Categoría -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-tags"></i>
                                    Categoría
                                </div>
                                <div class="detail-value">
                                    <span class="badge-categoria">
                                        @(Model.IdCategoriaNavigation?.Nombre ?? "Sin categoría")
                                    </span>
                                </div>
                            </div>

                            <!-- Precio de Venta -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-dollar-sign"></i>
                                    Precio de Venta
                                </div>
                                <div class="detail-value">
                                    <span class="precio-destacado">Bs. @Model.PrecioVenta.ToString("N2")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- Stock -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-boxes"></i>
                                    Stock Disponible
                                </div>
                                <div class="detail-value">
                                    <span class="stock-destacado">@Model.Saldo unidades</span>
                                </div>
                            </div>

                            <!-- Usuario Registro -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-user"></i>
                                    Usuario de Registro
                                </div>
                                <div class="detail-value">
                                    @Model.UsuarioRegistro
                                </div>
                            </div>

                            <!-- Fecha Registro -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-calendar"></i>
                                    Fecha de Registro
                                </div>
                                <div class="detail-value">
                                    @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                            <!-- Estado -->
                            <div class="detail-row">
                                <div class="detail-label">
                                    <i class="fas fa-toggle-on"></i>
                                    Estado
                                </div>
                                <div class="detail-value">
                                    @if (Model.Estado == 1)
                                    {
                                        <span class="badge badge-estado badge-activo">
                                            <i class="fas fa-check-circle mr-1"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-estado badge-inactivo">
                                            <i class="fas fa-times-circle mr-1"></i>
                                            Inactivo
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="detail-row">
                        <div class="detail-label">
                            <i class="fas fa-align-left"></i>
                            Descripción
                        </div>
                        <div class="detail-value">
                            @(Model.Descripcion ?? "Sin descripción")
                        </div>
                    </div>

                    <!-- Formulario de eliminación -->
                    <form asp-action="Delete" class="mt-4 pt-3">
                        <input type="hidden" asp-for="Id" />
                        <div class="row">
                            <div class="col-md-6 mb-2 mb-md-0">
                                <button type="submit" class="btn btn-eliminar btn-block">
                                    <i class="fas fa-trash-alt mr-2"></i>
                                    Confirmar Eliminación
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a asp-action="Index" class="btn btn-cancelar btn-block">
                                    <i class="fas fa-times mr-2"></i>
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>