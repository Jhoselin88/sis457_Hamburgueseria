@model WebHamburgueseria.Models.Ventas
@{
    ViewData["Title"] = "Nueva Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* Ocultar imagen de fondo del layout */
        .bg-box {
            display: none !important;
        }

        body {
            background: linear-gradient(135deg, #000000 0%, #000000 100%) !important;
            min-height: 100vh;
        }

        .ventas-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .ventas-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 12px;
            padding: 40px;
            max-width: 900px;
            width: 100%;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }

        .card-header-title {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 35px;
            color: #2d3436;
            padding-bottom: 20px;
            border-bottom: 3px solid #ff6b35;
        }

            .card-header-title i {
                font-size: 2.5rem;
                color: #ff6b35;
            }

            .card-header-title h2 {
                font-size: 2.2rem;
                font-weight: 700;
                margin: 0;
            }

        .form-section {
            margin-bottom: 35px;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            color: #2d3436;
            font-size: 1.2rem;
            font-weight: 600;
        }

            .section-header i {
                font-size: 1.4rem;
                color: #ff6b35;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 0;
        }

        .form-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: #495057;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

            .form-label i {
                font-size: 1.1rem;
                color: #667eea;
            }

        .form-control, .form-select {
            width: 100%;
            border: 2px solid #ff6b35;
            border-radius: 8px;
            padding: 14px 18px;
            font-size: 0.95rem;
            background: white;
            color: #495057;
            transition: all 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #f7931e;
                box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.3);
                outline: none;
            }

            .form-control::placeholder {
                color: #adb5bd;
            }

        .cliente-info-box {
            background: linear-gradient(135deg, rgba(255, 107, 53, 0.1) 0%, rgba(247, 147, 30, 0.1) 100%);
            border: 2px solid #ff6b35;
            border-radius: 12px;
            padding: 20px;
            display: none;
        }

            .cliente-info-box.show {
                display: block;
            }

            .cliente-info-box .info-label {
                font-size: 0.85rem;
                color: #ff6b35;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .cliente-info-box .info-value {
                font-size: 1.3rem;
                color: #2d3436;
                font-weight: 700;
            }

        .productos-section {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .add-product-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 15px;
            align-items: end;
            margin-bottom: 25px;
        }

        .productos-section .section-header {
            color: white;
        }

            .productos-section .section-header i {
                color: #ff6b35;
            }

        .productos-section .form-label {
            color: white;
        }

            .productos-section .form-label i {
                color: #ff6b35;
            }

        .btn-agregar {
            background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
            color: white;
            border: none;
            padding: 14px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.4);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-agregar:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(255, 107, 53, 0.6);
            }

        .productos-table {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            margin-top: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

            .productos-table table {
                width: 100%;
                border-collapse: collapse;
            }

                .productos-table table thead {
                    background: linear-gradient(135deg, #783022 0%, #E02804 100%);
                    color: white;
                }

                    .productos-table table thead th {
                        padding: 18px;
                        text-align: left;
                        font-weight: 600;
                        font-size: 0.85rem;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        border: none;
                    }

                .productos-table table tbody td {
                    padding: 18px;
                    border-top: 1px solid #e9ecef;
                    color: #495057;
                    font-size: 0.95rem;
                    vertical-align: middle;
                }

                .productos-table table tbody tr {
                    background: white;
                    transition: all 0.2s;
                }

                    .productos-table table tbody tr:hover {
                        background: #f8f9fa;
                        box-shadow: 0 2px 8px rgba(108, 92, 231, 0.15);
                        transform: scale(1.01);
                    }

        .btn-eliminar {
            background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
            color: white;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-eliminar:hover {
                transform: scale(1.15) translateY(-3px);
                box-shadow: 0 4px 12px rgba(186, 46, 17, 0.4);
            }

        .totals-section {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .total-box {
            background: white;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

            .total-box .label {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                color: #2d3436;
                font-weight: 600;
                margin-bottom: 12px;
                font-size: 0.95rem;
            }

                .total-box .label i {
                    font-size: 1.2rem;
                    color: #ff6b35;
                }

            .total-box input {
                width: 100%;
                border: 2px solid #ff6b35;
                border-radius: 8px;
                padding: 12px;
                font-size: 1.3rem;
                font-weight: 700;
                text-align: center;
                background: white;
                color: #2d3436;
            }

                .total-box input:focus {
                    border-color: #f7931e;
                    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.3);
                    outline: none;
                }

            .total-box .value {
                font-size: 1.5rem;
                font-weight: 700;
                color: #2d3436;
            }

        .actions-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .btn-guardar {
            background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
            color: white;
            border: none;
            padding: 16px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(25, 158, 55, 0.3);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-guardar:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(25, 158, 55, 0.4);
            }

        .btn-cancelar {
            background: linear-gradient(135deg, #BA2E11 0%, #82220E 100%);
            color: white;
            border: none;
            padding: 16px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(186, 46, 17, 0.3);
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-cancelar:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(186, 46, 17, 0.4);
                color: white;
            }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #adb5bd;
        }

            .empty-state p {
                margin: 0;
                font-size: 1rem;
            }

        .text-danger {
            color: #f5576c;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        /* Sugerencias de búsqueda */
        .search-suggestions {
            position: absolute;
            background: white;
            border: 2px solid #ff6b35;
            border-radius: 8px;
            max-height: 300px;
            overflow-y: auto;
            width: calc(100% - 4px);
            z-index: 1000;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            margin-top: 5px;
            display: none;
        }

            .search-suggestions.show {
                display: block;
            }

            .search-suggestions .suggestion-item {
                padding: 14px 18px;
                cursor: pointer;
                border-bottom: 1px solid #e9ecef;
                transition: background 0.2s;
                color: #495057;
            }

                .search-suggestions .suggestion-item:last-child {
                    border-bottom: none;
                }

                .search-suggestions .suggestion-item:hover {
                    background: #f8f9fa;
                }

                .search-suggestions .suggestion-item .cliente-nombre {
                    font-weight: 600;
                    font-size: 0.95rem;
                    color: #2d3436;
                }

                .search-suggestions .suggestion-item .cliente-ci {
                    font-size: 0.85rem;
                    color: #ff6b35;
                    margin-top: 2px;
                }

            .search-suggestions .no-results {
                padding: 14px 18px;
                color: #adb5bd;
                text-align: center;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .ventas-card

        {
            padding: 25px;
        }

        .form-row, .add-product-row, .totals-section, .actions-section {
            grid-template-columns: 1fr;
        }

        .card-header-title h2 {
            font-size: 1.8rem;
        }

        }</style>
}

<div class="ventas-container">
    <div class="ventas-card">
        <form asp-action="Create" method="post" id="formVenta">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Sección Cliente -->
            <div class="form-section">
                <div class="section-header">
                    <i class="fa fa-user"></i>
                    <span>Cliente</span>
                </div>

                <div class="form-row">
                    <div class="form-group" style="position: relative;">
                        <label class="form-label">
                            <i class="fa fa-search"></i>
                            Buscar Cliente
                        </label>
                        <input type="text"
                               id="buscarCliente"
                               class="form-control"
                               placeholder="Buscar por nombre o CI..."
                               autocomplete="off" />

                        <!-- Sugerencias de búsqueda -->
                        <div id="searchSuggestions" class="search-suggestions"></div>

                        <!-- Campo oculto para enviar el ID del cliente -->
                        <input type="hidden" asp-for="IdCliente" id="clienteIdHidden" />
                        <span asp-validation-for="IdCliente" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <div id="clienteInfoBox" class="cliente-info-box">
                            <div class="info-label">Cliente Seleccionado:</div>
                            <div class="info-value" id="clienteNombre">-</div>
                            <div style="font-size: 0.9rem; color: #795548; margin-top: 8px;" id="clienteCI">-</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección Agregar Productos -->
            <div class="productos-section">
                <div class="section-header">
                    <i class="fa fa-shopping-basket"></i>
                    <span>Agregar Productos</span>
                </div>

                <div class="add-product-row">
                    <div class="form-group">
                        <label class="form-label">Producto</label>
                        <select class="form-control form-select" id="productoSelect">
                            <option value="">Seleccione un producto</option>
                            @if (ViewBag.Productos != null)
                            {
                                foreach (var producto in ViewBag.Productos)
                                {
                                    <option value="@producto.Id">
                                        @producto.Nombre - Bs. @producto.PrecioVenta
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Cantidad</label>
                        <input type="number" class="form-control" id="cantidadInput" value="1" min="1" step="1" />
                    </div>
                </div>

                <button type="button" class="btn-agregar" id="btnAgregar" style="width: 100%;">
                    <i class="fa fa-plus-circle"></i>
                    Agregar Producto
                </button>

                <!-- Tabla de productos -->
                <div class="productos-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Total</th>
                                <th style="text-align: center;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="productosTableBody">
                            <!-- Productos dinámicos -->
                        </tbody>
                    </table>
                    <div id="emptyState" class="empty-state">
                        <p>No hay productos agregados</p>
                    </div>
                </div>
            </div>

            <!-- Sección de Totales -->
            <div class="totals-section">
                <div class="total-box">
                    <div class="label">
                        <i class="fa fa-wallet"></i>
                        Efectivo
                    </div>
                    <input type="number" id="pagoCliente" value="0.00" step="0.01" min="0" />
                </div>

                <div class="total-box">
                    <div class="label">
                        <i class="fa fa-calculator"></i>
                        Total
                    </div>
                    <div class="value" id="totalValue">Bs. 0.00</div>
                </div>

                <div class="total-box">
                    <div class="label">
                        <i class="fa fa-coins"></i>
                        Cambio
                    </div>
                    <div class="value" id="cambioValue">Bs. 0.00</div>
                </div>
            </div>

            <!-- Campos ocultos requeridos -->
            <input type="hidden" asp-for="NumeroTransaccion" value="TXN-AUTO" />
            <input type="hidden" asp-for="FechaRegistro" id="fechaRegistroHidden" />
            <input type="hidden" asp-for="IdUsuario" id="usuarioHidden" />
            <input type="hidden" asp-for="UsuarioRegistro" value="Admin" />
            <input type="hidden" asp-for="Estado" value="1" />
            <input type="hidden" id="detallesVentaJson" name="DetallesVentaJson" />

            <!-- Botones de Acción -->
            <div class="actions-section">
                <button type="submit" class="btn-guardar">
                    <i class="fa fa-save"></i>
                    Guardar Pedido
                </button>
                <a asp-action="Index" class="btn-cancelar">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ===== DESHABILITAR ERROR DE GOOGLE MAPS SI NO SE USA =====
        window.console.error = (function(oldError) {
            return function(error) {
                if (typeof error === 'string' && error.includes('InvalidValueError')) {
                    return;
                }
                oldError.apply(console, arguments);
            };
        })(window.console.error);

        // ===== CARGAR PRODUCTOS DESDE JSON =====
        const productosData = @Html.Raw(ViewBag.ProductosJson ?? "[]");
        console.log('Productos cargados:', productosData);

        // Crear un mapa de productos por ID para acceso rápido
        const productosMap = new Map();
        productosData.forEach(prod => {
            productosMap.set(prod.Id, prod);
        });

        // ===== CARGAR CLIENTES =====
        const clientesData = @Html.Raw(ViewBag.ClientesJson ?? "[]");
        console.log('Clientes cargados:', clientesData);

        // Referencias a elementos del DOM
        const pagoClienteInput = document.getElementById('pagoCliente');
        const totalValue = document.getElementById('totalValue');
        const cambioValue = document.getElementById('cambioValue');
        const emptyState = document.getElementById('emptyState');
        const productosTableBody = document.getElementById('productosTableBody');
        const productoSelect = document.getElementById('productoSelect');
        const cantidadInput = document.getElementById('cantidadInput');
        const buscarClienteInput = document.getElementById('buscarCliente');
        const searchSuggestions = document.getElementById('searchSuggestions');
        const clienteInfoBox = document.getElementById('clienteInfoBox');
        const clienteNombre = document.getElementById('clienteNombre');
        const clienteCI = document.getElementById('clienteCI');
        const clienteIdHidden = document.getElementById('clienteIdHidden');

        // Array para almacenar los productos agregados
        let productosAgregados = [];
        let contadorProductos = 0;

        // Cliente seleccionado
        let clienteSeleccionado = null;

        // Establecer fecha actual automáticamente
        const ahora = new Date();
        const year = ahora.getFullYear();
        const month = String(ahora.getMonth() + 1).padStart(2, '0');
        const day = String(ahora.getDate()).padStart(2, '0');
        const hours = String(ahora.getHours()).padStart(2, '0');
        const minutes = String(ahora.getMinutes()).padStart(2, '0');
        const fechaISO = `${year}-${month}-${day}T${hours}:${minutes}`;
        document.getElementById('fechaRegistroHidden').value = fechaISO;

        // Establecer usuario por defecto
        @if (ViewBag.IdUsuario != null)
        {
                @:var selectUsuario = @Html.Raw(Json.Serialize(ViewBag.IdUsuario));
                @:if (selectUsuario && selectUsuario.length > 0) {
                    @:document.getElementById('usuarioHidden').value = selectUsuario[0].value;
                @:}
        }

        // ===== BÚSQUEDA DE CLIENTES CON SUGERENCIAS =====
        buscarClienteInput.addEventListener('input', function () {
            const searchTerm = this.value.toLowerCase().trim();

            if (searchTerm === '') {
                searchSuggestions.classList.remove('show');
                searchSuggestions.innerHTML = '';
                return;
            }

            // Filtrar clientes
            const resultados = clientesData.filter(cliente => {
                const nombreCompleto = `${cliente.Nombres} ${cliente.Apellidos}`.toLowerCase();
                const ci = cliente.CedulaIdentidad.toLowerCase();
                return nombreCompleto.includes(searchTerm) || ci.includes(searchTerm);
            });

            // Mostrar resultados
            if (resultados.length > 0) {
                searchSuggestions.innerHTML = resultados.map(cliente => `
                    <div class="suggestion-item" data-id="${cliente.Id}" data-nombre="${cliente.Nombres} ${cliente.Apellidos}" data-ci="${cliente.CedulaIdentidad}">
                        <div class="cliente-nombre">${cliente.Nombres} ${cliente.Apellidos}</div>
                        <div class="cliente-ci">CI: ${cliente.CedulaIdentidad}</div>
                    </div>
                `).join('');
                searchSuggestions.classList.add('show');
            } else {
                searchSuggestions.innerHTML = '<div class="no-results">No se encontraron clientes</div>';
                searchSuggestions.classList.add('show');
            }
        });

        // Seleccionar cliente de las sugerencias
        searchSuggestions.addEventListener('click', function(e) {
            const suggestionItem = e.target.closest('.suggestion-item');
            if (suggestionItem) {
                const clienteId = suggestionItem.getAttribute('data-id');
                const nombre = suggestionItem.getAttribute('data-nombre');
                const ci = suggestionItem.getAttribute('data-ci');

                // Actualizar campos
                buscarClienteInput.value = nombre;
                clienteIdHidden.value = clienteId;
                clienteNombre.textContent = nombre;
                clienteCI.textContent = `CI: ${ci}`;
                clienteInfoBox.classList.add('show');

                // Ocultar sugerencias
                searchSuggestions.classList.remove('show');
                searchSuggestions.innerHTML = '';

                clienteSeleccionado = { id: clienteId, nombre: nombre, ci: ci };
            }
        });

        // Cerrar sugerencias al hacer clic fuera
        document.addEventListener('click', function(e) {
            if (!buscarClienteInput.contains(e.target) && !searchSuggestions.contains(e.target)) {
                searchSuggestions.classList.remove('show');
            }
        });

        // ===== CALCULAR CAMBIO =====
        pagoClienteInput.addEventListener('input', calcularCambio);

        function calcularCambio() {
            const totalText = totalValue.textContent.replace('Bs. ', '').trim();
            const total = parseFloat(totalText) || 0;
            const pago = parseFloat(pagoClienteInput.value) || 0;
            const cambio = pago - total;

            cambioValue.textContent = 'Bs. ' + cambio.toFixed(2);
        }

        // ===== AGREGAR PRODUCTO =====
        document.getElementById('btnAgregar').addEventListener('click', function () {
            // Validar que se haya seleccionado un producto
            if (!productoSelect.value) {
                alert('Por favor seleccione un producto');
                return;
            }

            // Validar cantidad
            const cantidad = parseInt(cantidadInput.value);
            if (cantidad <= 0 || isNaN(cantidad)) {
                alert('Por favor ingrese una cantidad válida mayor a 0');
                return;
            }

            const productoId = parseInt(productoSelect.value);
            const producto = productosMap.get(productoId);

            if (!producto) {
                alert('Error: No se encontró el producto seleccionado');
                return;
            }

            const precioUnitario = parseFloat(producto.PrecioVenta);

            if (isNaN(precioUnitario) || precioUnitario <= 0) {
                alert('Error: El precio del producto no es válido');
                return;
            }

            const subtotal = cantidad * precioUnitario;
            const productoNombre = producto.Nombre;

            // Agregar al array de productos
            productosAgregados.push({
                IdProducto: productoId,
                Cantidad: cantidad,
                PrecioUnitario: precioUnitario,
                Subtotal: subtotal
            });

            // Agregar a la tabla visualmente
            const row = productosTableBody.insertRow();
            row.setAttribute('data-index', contadorProductos);
            row.innerHTML = `
                <td>${productoNombre}</td>
                <td>${cantidad}</td>
                <td>Bs. ${precioUnitario.toFixed(2)}</td>
                <td>Bs. ${subtotal.toFixed(2)}</td>
                <td style="text-align: center;">
                    <button type="button" class="btn-eliminar" onclick="eliminarProducto(${contadorProductos})">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            `;

            contadorProductos++;
            actualizarTotal();
            verificarTablaVacia();

            // Limpiar campos
            productoSelect.value = '';
            cantidadInput.value = '1';
        });

        // ===== ELIMINAR PRODUCTO =====
        function eliminarProducto(index) {
            if (confirm('¿Está seguro de eliminar este producto?')) {
                const row = document.querySelector(`tr[data-index="${index}"]`);
                if (row) {
                    row.remove();
                }

                const arrayIndex = productosAgregados.findIndex((p, i) => {
                    const rowElement = document.querySelector(`tr[data-index="${i}"]`);
                    return rowElement && rowElement.getAttribute('data-index') == index;
                });

                if (arrayIndex !== -1) {
                    productosAgregados.splice(arrayIndex, 1);
                }

                actualizarTotal();
                verificarTablaVacia();
            }
        }

        // ===== ACTUALIZAR TOTAL =====
        function actualizarTotal() {
            let total = 0;
            productosAgregados.forEach(producto => {
                total += producto.Subtotal;
            });

            totalValue.textContent = 'Bs. ' + total.toFixed(2);
            calcularCambio();
        }

        // ===== VERIFICAR SI LA TABLA ESTÁ VACÍA =====
        function verificarTablaVacia() {
            emptyState.style.display = productosTableBody.children.length === 0 ? 'block' : 'none';
        }

        // ===== ENVIAR FORMULARIO =====
        document.getElementById('formVenta').addEventListener('submit', function (e) {
            if (productosAgregados.length === 0) {
                e.preventDefault();
                alert('Debe agregar al menos un producto a la venta');
                return false;
            }

            if (!clienteIdHidden.value) {
                e.preventDefault();
                alert('Debe seleccionar un cliente');
                return false;
            }

            document.getElementById('detallesVentaJson').value = JSON.stringify(productosAgregados);
            console.log('Productos enviados:', productosAgregados);
            return true;
        });

        // Inicializar vista
        verificarTablaVacia();
    </script>
}