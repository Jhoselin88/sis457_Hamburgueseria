@model WebHamburgueseria.Models.Ventas
@{
    ViewData["Title"] = "Registro de Pedidos";
    ViewData["BodyClass"] = "";
}

@section Styles {
    <style>
        /* Ocultar imagen de fondo del layout */
        .bg-box {
            display: none !important;
        }

        body {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%) !important;
            min-height: 100vh;
        }

        .ventas-wrapper {
            padding: 20px;
            min-height: 100vh;
        }

        .ventas-header {
            background: linear-gradient(135deg, #d2691e 0%, #cd853f 100%);
            padding: 20px 40px;
            border-radius: 10px 10px 0 0;
            margin-bottom: 0;
        }

            .ventas-header h2 {
                color: white;
                font-size: 32px;
                font-weight: 700;
                margin: 0;
                text-align: center;
                text-transform: uppercase;
                letter-spacing: 2px;
            }

        .ventas-content {
            display: grid;
            grid-template-columns: 500px 1fr;
            gap: 20px;
            align-items: start;
        }

        /* SECCIÓN IZQUIERDA - DATOS DEL CLIENTE */
        .cliente-section {
            background: white;
            border-radius: 0 0 10px 10px;
            padding: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            display: block;
            font-size: 14px;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #d2691e;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s;
        }

            .form-control:focus {
                border-color: #cd853f;
                outline: none;
                box-shadow: 0 0 0 3px rgba(210, 105, 30, 0.2);
            }

        .cliente-info-display {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #d2691e;
            display: none;
        }

            .cliente-info-display.show {
                display: block;
            }

            .cliente-info-display .cliente-nombre {
                font-size: 18px;
                font-weight: 700;
                color: #2c3e50;
                margin-bottom: 5px;
            }

            .cliente-info-display .cliente-ci {
                color: #6c757d;
                font-size: 14px;
            }

        .search-suggestions {
            position: absolute;
            background: white;
            border: 2px solid #d2691e;
            border-radius: 8px;
            max-height: 250px;
            overflow-y: auto;
            width: calc(100% - 4px);
            z-index: 1000;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            margin-top: 5px;
            display: none;
        }

            .search-suggestions.show {
                display: block;
            }

            .search-suggestions .suggestion-item {
                padding: 12px 15px;
                cursor: pointer;
                border-bottom: 1px solid #e9ecef;
                transition: background 0.2s;
            }

                .search-suggestions .suggestion-item:hover {
                    background: #f8f9fa;
                }

                .search-suggestions .suggestion-item .cliente-nombre {
                    font-weight: 600;
                    color: #2c3e50;
                }

                .search-suggestions .suggestion-item .cliente-ci {
                    font-size: 12px;
                    color: #d2691e;
                }

        /* TABLA DE PRODUCTOS AGREGADOS */
        .productos-table {
            margin-top: 30px;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .productos-table table {
                width: 100%;
                border-collapse: collapse;
            }

                .productos-table table thead {
                    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
                }

                    .productos-table table thead th {
                        padding: 15px;
                        text-align: left;
                        color: white;
                        font-weight: 600;
                        font-size: 12px;
                        text-transform: uppercase;
                    }

                .productos-table table tbody td {
                    padding: 15px;
                    border-bottom: 1px solid #e9ecef;
                    color: #2c3e50;
                }

                .productos-table table tbody tr:hover {
                    background: #f8f9fa;
                }

        .btn-delete-product {
            background: #dc3545;
            color: white;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-delete-product:hover {
                background: #c82333;
                transform: scale(1.1);
            }

        /* TOTALES */
        .totals-section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            margin-top: 20px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .total-row:last-child {
                border-bottom: none;
                margin-top: 10px;
                padding-top: 15px;
                border-top: 2px solid #d2691e;
            }

            .total-row .label {
                font-weight: 600;
                color: #2c3e50;
                font-size: 16px;
            }

            .total-row .value {
                font-size: 20px;
                font-weight: 700;
                color: #d2691e;
            }

            .total-row input {
                width: 150px;
                padding: 8px 12px;
                border: 2px solid #d2691e;
                border-radius: 6px;
                font-size: 18px;
                font-weight: 600;
                text-align: right;
            }

        /* BOTONES */
        .actions-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .btn-guardar {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-guardar:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(40, 167, 69, 0.4);
            }

        /* BOTÓN CANCELAR - ACTUALIZADO */
        .btn-cancelar {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

            .btn-cancelar:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(220, 53, 69, 0.4);
                color: white;
                text-decoration: none;
            }

        /* SECCIÓN DERECHA - PRODUCTOS */
        .productos-section {
            background: linear-gradient(135deg, #cd853f 0%, #d2691e 100%);
            border-radius: 10px;
            padding: 20px;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
            position: sticky;
            top: 20px;
            min-width: 900px;
        }

            .productos-section h3 {
                color: white;
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 20px;
                text-align: center;
                text-transform: uppercase;
            }

        .productos-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .producto-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            transition: all 0.3s;
            cursor: pointer;
        }

            .producto-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            }

            .producto-card.no-stock {
                opacity: 0.6;
                cursor: not-allowed;
            }

                .producto-card.no-stock:hover {
                    transform: none;
                }

        .producto-img {
            width: 100%;
            height: 120px;
            object-fit: cover;
            background: #f8f9fa;
            display: block;
        }

        .producto-info {
            padding: 10px;
        }

            .producto-info .nombre {
                font-weight: 700;
                color: #2c3e50;
                font-size: 13px;
                margin-bottom: 4px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .producto-info .stock {
                font-size: 10px;
                color: #6c757d;
                margin-bottom: 6px;
            }

                .producto-info .stock.bajo-stock {
                    color: #dc3545;
                    font-weight: 600;
                }

            .producto-info .precio {
                font-size: 16px;
                font-weight: 700;
                color: #d2691e;
                margin-bottom: 8px;
            }

        .producto-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .producto-actions input {
                width: 50px;
                padding: 5px;
                border: 2px solid #d2691e;
                border-radius: 6px;
                text-align: center;
                font-weight: 600;
                font-size: 12px;
            }

        .btn-agregar-producto {
            flex: 1;
            background: #d2691e;
            color: white;
            border: none;
            padding: 6px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-agregar-producto:hover {
                background: #cd853f;
            }

            .btn-agregar-producto:disabled {
                background: #ccc;
                cursor: not-allowed;
            }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #6c757d;
        }

        .btn-nuevo-cliente {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-nuevo-cliente:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(52, 152, 219, 0.4);
            }

        /* Scrollbar personalizado */
        .productos-section::-webkit-scrollbar {
            width: 8px;
        }

        .productos-section::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        .productos-section::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }

            .productos-section::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.5);
            }

        /* Responsive */
        @@media (max-width: 1400px) {
            .productos-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .productos-section {
                min-width: 700px;
            }
        }

        @@media (max-width: 1200px) {
            .ventas-content {
                grid-template-columns: 1fr;
            }

            .productos-section {
                position: relative;
                top: 0;
                max-height: 600px;
                min-width: auto;
            }

            .productos-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .productos-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .actions-buttons {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            .productos-grid {
                grid-template-columns: 1fr;
            }
        }

        /* MODAL NUEVO CLIENTE */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-content {
            background: white;
            border-radius: 12px;
            width: 90%;
            max-width: 500px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            animation: modalSlideIn 0.3s ease-out;
        }

        @@keyframes modalSlideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .modal-header h3 {
                margin: 0;
                font-size: 20px;
                font-weight: 700;
            }

        .btn-close-modal {
            background: none;
            border: none;
            color: white;
            font-size: 24px;
            cursor: pointer;
            padding: 0;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

            .btn-close-modal:hover {
                transform: rotate(90deg);
            }

        .modal-body {
            padding: 25px;
        }

        .modal-form-group {
            margin-bottom: 20px;
        }

            .modal-form-group label {
                font-weight: 600;
                color: #2c3e50;
                margin-bottom: 8px;
                display: block;
                font-size: 14px;
            }

            .modal-form-group input {
                width: 100%;
                padding: 12px 15px;
                border: 2px solid #e9ecef;
                border-radius: 8px;
                font-size: 14px;
                transition: all 0.3s;
            }

                .modal-form-group input:focus {
                    border-color: #3498db;
                    outline: none;
                    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
                }

            .modal-form-group .error-message {
                color: #dc3545;
                font-size: 12px;
                margin-top: 5px;
                display: none;
            }

                .modal-form-group .error-message.show {
                    display: block;
                }

        .modal-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 25px;
        }

        .btn-modal-guardar {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-modal-guardar:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(40, 167, 69, 0.4);
            }

            .btn-modal-guardar:disabled {
                background: #ccc;
                cursor: not-allowed;
                transform: none;
            }

        .btn-modal-cancelar {
            background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-modal-cancelar:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(108, 117, 125, 0.4);
            }
    </style>
}

<div class="ventas-wrapper">
    <div class="ventas-header">
        <h2>Registro de Ventas</h2>
    </div>

    <div class="ventas-content">
        <!-- SECCIÓN IZQUIERDA: Datos del Cliente y Productos Agregados -->
        <div>
            <div class="cliente-section">
                <form asp-action="Create" method="post" id="formVenta">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Fecha -->
                    <div class="form-group">
                        <label class="form-label">Fecha</label>
                        <input type="datetime-local" class="form-control" id="fechaInput" readonly />
                    </div>

                    <!-- Búsqueda de Cliente -->
                    <div class="form-group" style="position: relative;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label class="form-label" style="margin-bottom: 0;">NIT/CI</label>
                            <button type="button" class="btn-nuevo-cliente" onclick="abrirModalCliente()">
                                <i class="fa fa-user-plus"></i> Nuevo Cliente
                            </button>
                        </div>
                        <input type="text"
                               id="buscarCliente"
                               class="form-control"
                               placeholder="Buscar por nombre o CI..."
                               autocomplete="off" />
                        <div id="searchSuggestions" class="search-suggestions"></div>
                        <input type="hidden" asp-for="IdCliente" id="clienteIdHidden" />
                    </div>

                    <!-- Info del Cliente -->
                    <div class="form-group">
                        <label class="form-label">Nombre</label>
                        <div id="clienteInfoDisplay" class="cliente-info-display">
                            <div class="cliente-nombre" id="clienteNombre">-</div>
                            <div class="cliente-ci" id="clienteCI">-</div>
                        </div>
                    </div>

                    <!-- Tabla de Productos Agregados -->
                    <div class="productos-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio Unitario</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="productosTableBody">
                            </tbody>
                        </table>
                        <div id="emptyState" class="empty-state">
                            No hay productos agregados
                        </div>
                    </div>

                    <!-- Totales -->
                    <div class="totals-section">
                        <div class="total-row">
                            <span class="label">Total:</span>
                            <span class="value" id="totalValue">Bs. 0.00</span>
                        </div>
                        <div class="total-row">
                            <span class="label">Efectivo:</span>
                            <input type="number" id="pagoCliente" value="0.00" step="0.01" min="0" />
                        </div>
                        <div class="total-row">
                            <span class="label">Cambio:</span>
                            <span class="value" id="cambioValue">Bs. 0.00</span>
                        </div>
                    </div>

                    <!-- Campos ocultos -->
                    <input type="hidden" asp-for="NumeroTransaccion" value="TXN-AUTO" />
                    <input type="hidden" asp-for="FechaRegistro" id="fechaRegistroHidden" />
                    <input type="hidden" asp-for="IdUsuario" id="usuarioHidden" value="1" />
                    <input type="hidden" asp-for="UsuarioRegistro" value="Admin" />
                    <input type="hidden" asp-for="Estado" value="1" />
                    <input type="hidden" id="detallesVentaJson" name="DetallesVentaJson" />

                    <!-- Botones - ACTUALIZADO CON CANCELAR -->
                    <div class="actions-buttons">
                        <button type="submit" class="btn-guardar">Guardar</button>
                        <a href="@Url.Action("Index", "Ventas")" class="btn-cancelar">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- SECCIÓN DERECHA: Productos Disponibles -->
        <div class="productos-section">
            <h3>Productos Disponibles</h3>
            <div class="productos-grid" id="productosGrid">
                <!-- Los productos se cargarán aquí dinámicamente -->
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA CREAR NUEVO CLIENTE -->
<div class="modal-overlay" id="modalNuevoCliente">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fa fa-user-plus"></i> Nuevo Cliente</h3>
            <button class="btn-close-modal" onclick="cerrarModalCliente()">
                <i class="fa fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="formNuevoCliente" onsubmit="return false;">
                <div class="modal-form-group">
                    <label>Cédula de Identidad *</label>
                    <input type="text" id="modalCI" placeholder="Ej: 12345678" required />
                    <span class="error-message" id="errorCI"></span>
                </div>

                <div class="modal-form-group">
                    <label>Nombres *</label>
                    <input type="text" id="modalNombres" placeholder="Ej: Juan Carlos" required />
                    <span class="error-message" id="errorNombres"></span>
                </div>

                <div class="modal-form-group">
                    <label>Apellidos *</label>
                    <input type="text" id="modalApellidos" placeholder="Ej: Pérez López" required />
                    <span class="error-message" id="errorApellidos"></span>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-modal-guardar" onclick="guardarNuevoCliente()">
                        <i class="fa fa-save"></i> Guardar
                    </button>
                    <button type="button" class="btn-modal-cancelar" onclick="cerrarModalCliente()">
                        <i class="fa fa-times"></i> Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- AQUÍ TERMINA LA PARTE 1 -->
<!-- CONTINÚA EN LA PARTE 2 CON LA SECCIÓN  Scripts -->
@section Scripts {
    <script>
        // Cargar productos y clientes
        const productosData = @Html.Raw(ViewBag.ProductosJson ?? "[]");
        const clientesData = @Html.Raw(ViewBag.ClientesJson ?? "[]");

        // Variables globales
        let productosAgregados = [];
        let contadorProductos = 0;

        // Referencias DOM
        const productosGrid = document.getElementById('productosGrid');
        const productosTableBody = document.getElementById('productosTableBody');
        const emptyState = document.getElementById('emptyState');
        const totalValue = document.getElementById('totalValue');
        const pagoClienteInput = document.getElementById('pagoCliente');
        const cambioValue = document.getElementById('cambioValue');
        const buscarClienteInput = document.getElementById('buscarCliente');
        const searchSuggestions = document.getElementById('searchSuggestions');
        const clienteInfoDisplay = document.getElementById('clienteInfoDisplay');
        const clienteNombre = document.getElementById('clienteNombre');
        const clienteCI = document.getElementById('clienteCI');
        const clienteIdHidden = document.getElementById('clienteIdHidden');
        const fechaInput = document.getElementById('fechaInput');

        // Establecer fecha actual
        const ahora = new Date();
        fechaInput.value = ahora.toISOString().slice(0, 16);
        document.getElementById('fechaRegistroHidden').value = ahora.toISOString().slice(0, 16);

        // FUNCIÓN PARA OBTENER IMAGEN DEL PRODUCTO
        function obtenerImagenProducto(producto) {
            // Si tiene imagen propia, usarla
            if (producto.RutaImagen && producto.RutaImagen.trim() !== '') {
                return producto.RutaImagen;
            }
            // Si no, usar imagen por defecto
            return '/images/producto-default.png';
        }

        // RENDERIZAR PRODUCTOS - ACTUALIZADO
        function renderizarProductos() {
            productosGrid.innerHTML = productosData.map(producto => {
                const imagenUrl = obtenerImagenProducto(producto);
                return `
                    <div class="producto-card ${producto.Saldo <= 0 ? 'no-stock' : ''}" data-id="${producto.Id}">
                        <img src="${imagenUrl}"
                             alt="${producto.Nombre}"
                             class="producto-img"
                             onerror="this.src='/images/producto-default.png'">
                        <div class="producto-info">
                            <div class="nombre">${producto.Nombre}</div>
                            <div class="stock ${producto.Saldo < 10 ? 'bajo-stock' : ''}">
                                Stock: ${producto.Saldo}
                            </div>
                            <div class="precio">Bs. ${parseFloat(producto.PrecioVenta).toFixed(2)}</div>
                            <div class="producto-actions">
                                <input type="number"
                                       class="cantidad-input"
                                       value="1"
                                       min="1"
                                       max="${producto.Saldo}"
                                       ${producto.Saldo <= 0 ? 'disabled' : ''}>
                                <button class="btn-agregar-producto"
                                        onclick="agregarProducto(${producto.Id})"
                                        ${producto.Saldo <= 0 ? 'disabled' : ''}>
                                    Agregar
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // AGREGAR PRODUCTO
        function agregarProducto(productoId) {
            const producto = productosData.find(p => p.Id === productoId);
            if (!producto) return;

            const card = document.querySelector(`.producto-card[data-id="${productoId}"]`);
            const cantidadInput = card.querySelector('.cantidad-input');
            const cantidad = parseInt(cantidadInput.value);

            if (cantidad <= 0 || cantidad > producto.Saldo) {
                alert('Cantidad inválida');
                return;
            }

            const precioUnitario = parseFloat(producto.PrecioVenta);
            const subtotal = cantidad * precioUnitario;

            productosAgregados.push({
                IdProducto: productoId,
                Cantidad: cantidad,
                PrecioUnitario: precioUnitario,
                Subtotal: subtotal
            });

            const row = productosTableBody.insertRow();
            row.setAttribute('data-index', contadorProductos);
            row.innerHTML = `
                <td>${producto.Nombre}</td>
                <td>${cantidad}</td>
                <td>Bs. ${precioUnitario.toFixed(2)}</td>
                <td>Bs. ${subtotal.toFixed(2)}</td>
                <td>
                    <button type="button" class="btn-delete-product" onclick="eliminarProducto(${contadorProductos})">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            `;

            contadorProductos++;
            actualizarTotal();
            verificarTablaVacia();
            cantidadInput.value = '1';
        }

        // ELIMINAR PRODUCTO - CORREGIDO
        function eliminarProducto(index) {
            // Eliminar fila visual
            const row = document.querySelector(`tr[data-index="${index}"]`);
            if (row) {
                row.remove();
            }

            // Reconstruir el array solo con los productos que tienen fila visible
            const productosTemp = [];
            productosTableBody.querySelectorAll('tr').forEach((row, i) => {
                const oldIndex = parseInt(row.getAttribute('data-index'));
                if (productosAgregados[oldIndex]) {
                    productosTemp.push(productosAgregados[oldIndex]);
                    // Actualizar el data-index de la fila
                    row.setAttribute('data-index', i);
                    // Actualizar el onclick del botón eliminar
                    const btnEliminar = row.querySelector('.btn-delete-product');
                    if (btnEliminar) {
                        btnEliminar.setAttribute('onclick', `eliminarProducto(${i})`);
                    }
                }
            });

            // Reemplazar el array con los productos que quedaron
            productosAgregados = productosTemp;
            contadorProductos = productosAgregados.length;

            actualizarTotal();
            verificarTablaVacia();
        }

        // ACTUALIZAR TOTAL
        function actualizarTotal() {
            const total = productosAgregados.reduce((sum, p) => sum + p.Subtotal, 0);
            totalValue.textContent = 'Bs. ' + total.toFixed(2);
            calcularCambio();
        }

        // CALCULAR CAMBIO
        function calcularCambio() {
            const total = parseFloat(totalValue.textContent.replace('Bs. ', '')) || 0;
            const pago = parseFloat(pagoClienteInput.value) || 0;
            const cambio = pago - total;
            cambioValue.textContent = 'Bs. ' + cambio.toFixed(2);
        }

        pagoClienteInput.addEventListener('input', calcularCambio);

        // VERIFICAR TABLA VACÍA
        function verificarTablaVacia() {
            emptyState.style.display = productosTableBody.children.length === 0 ? 'block' : 'none';
        }

        // BÚSQUEDA DE CLIENTES
        buscarClienteInput.addEventListener('input', function () {
            const searchTerm = this.value.toLowerCase().trim();

            if (searchTerm === '') {
                searchSuggestions.classList.remove('show');
                return;
            }

            const resultados = clientesData.filter(cliente => {
                const nombreCompleto = `${cliente.Nombres} ${cliente.Apellidos}`.toLowerCase();
                const ci = cliente.CedulaIdentidad.toLowerCase();
                return nombreCompleto.includes(searchTerm) || ci.includes(searchTerm);
            });

            if (resultados.length > 0) {
                searchSuggestions.innerHTML = resultados.map(cliente => `
                    <div class="suggestion-item"
                         data-id="${cliente.Id}"
                         data-nombre="${cliente.Nombres} ${cliente.Apellidos}"
                         data-ci="${cliente.CedulaIdentidad}">
                        <div class="cliente-nombre">${cliente.Nombres} ${cliente.Apellidos}</div>
                        <div class="cliente-ci">CI: ${cliente.CedulaIdentidad}</div>
                    </div>
                `).join('');
                searchSuggestions.classList.add('show');
            } else {
                searchSuggestions.innerHTML = '<div style="padding: 12px; text-align: center; color: #6c757d;">No se encontraron clientes</div>';
                searchSuggestions.classList.add('show');
            }
        });

        // SELECCIONAR CLIENTE
        searchSuggestions.addEventListener('click', function(e) {
            const item = e.target.closest('.suggestion-item');
            if (item) {
                const id = item.getAttribute('data-id');
                const nombre = item.getAttribute('data-nombre');
                const ci = item.getAttribute('data-ci');

                buscarClienteInput.value = ci;
                clienteIdHidden.value = id;
                clienteNombre.textContent = nombre;
                clienteCI.textContent = `CI: ${ci}`;
                clienteInfoDisplay.classList.add('show');
                searchSuggestions.classList.remove('show');
            }
        });

        // ENVIAR FORMULARIO
        document.getElementById('formVenta').addEventListener('submit', function (e) {
            if (productosAgregados.length === 0) {
                e.preventDefault();
                alert('Debe agregar al menos un producto');
                return false;
            }

            if (!clienteIdHidden.value) {
                e.preventDefault();
                alert('Debe seleccionar un cliente');
                return false;
            }

            document.getElementById('detallesVentaJson').value = JSON.stringify(productosAgregados);
            return true;
        });

        // INICIALIZAR
        renderizarProductos();
        verificarTablaVacia();

        // ==========================================
        // FUNCIONES PARA MODAL DE NUEVO CLIENTE
        // ==========================================

        function abrirModalCliente() {
            document.getElementById('modalNuevoCliente').classList.add('show');
            document.getElementById('modalCI').focus();
            limpiarFormularioCliente();
        }

        function cerrarModalCliente() {
            document.getElementById('modalNuevoCliente').classList.remove('show');
            limpiarFormularioCliente();
        }

        function limpiarFormularioCliente() {
            document.getElementById('modalCI').value = '';
            document.getElementById('modalNombres').value = '';
            document.getElementById('modalApellidos').value = '';

            // Limpiar errores
            document.querySelectorAll('.error-message').forEach(el => el.classList.remove('show'));
        }

        function validarFormularioCliente() {
            let valido = true;

            // Validar CI
            const ci = document.getElementById('modalCI').value.trim();
            const errorCI = document.getElementById('errorCI');
            if (!ci) {
                errorCI.textContent = 'La cédula es obligatoria';
                errorCI.classList.add('show');
                valido = false;
            } else if (ci.length < 5) {
                errorCI.textContent = 'La cédula debe tener al menos 5 caracteres';
                errorCI.classList.add('show');
                valido = false;
            } else {
                errorCI.classList.remove('show');
            }

            // Validar Nombres
            const nombres = document.getElementById('modalNombres').value.trim();
            const errorNombres = document.getElementById('errorNombres');
            if (!nombres) {
                errorNombres.textContent = 'El nombre es obligatorio';
                errorNombres.classList.add('show');
                valido = false;
            } else {
                errorNombres.classList.remove('show');
            }

            // Validar Apellidos
            const apellidos = document.getElementById('modalApellidos').value.trim();
            const errorApellidos = document.getElementById('errorApellidos');
            if (!apellidos) {
                errorApellidos.textContent = 'Los apellidos son obligatorios';
                errorApellidos.classList.add('show');
                valido = false;
            } else {
                errorApellidos.classList.remove('show');
            }

            return valido;
        }

        async function guardarNuevoCliente() {
            // Validar formulario
            if (!validarFormularioCliente()) {
                return;
            }

            // Deshabilitar botón
            const btnGuardar = event.target;
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Guardando...';

            // Obtener datos del formulario
            const nuevoCliente = {
                CedulaIdentidad: document.getElementById('modalCI').value.trim(),
                Nombres: document.getElementById('modalNombres').value.trim(),
                Apellidos: document.getElementById('modalApellidos').value.trim(),
                UsuarioRegistro: 'Admin'
            };

            try {
                // Enviar petición AJAX
                const response = await fetch('/Clientes/CrearClienteAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(nuevoCliente)
                });

                const result = await response.json();

                if (result.success) {
                    // Agregar cliente a la lista
                    clientesData.push({
                        Id: result.cliente.id,
                        Nombres: result.cliente.nombres,
                        Apellidos: result.cliente.apellidos,
                        CedulaIdentidad: result.cliente.cedulaIdentidad
                    });

                    // Seleccionar automáticamente el nuevo cliente
                    clienteIdHidden.value = result.cliente.id;
                    buscarClienteInput.value = result.cliente.cedulaIdentidad;
                    clienteNombre.textContent = `${result.cliente.nombres} ${result.cliente.apellidos}`;
                    clienteCI.textContent = `CI: ${result.cliente.cedulaIdentidad}`;
                    clienteInfoDisplay.classList.add('show');

                    // Cerrar modal
                    cerrarModalCliente();

                    // Mostrar mensaje de éxito
                    alert('¡Cliente creado exitosamente!');
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error al guardar el cliente. Por favor intente nuevamente.');
            } finally {
                // Rehabilitar botón
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i class="fa fa-save"></i> Guardar';
            }
        }

        // Cerrar modal al hacer clic fuera
        document.getElementById('modalNuevoCliente').addEventListener('click', function(e) {
            if (e.target === this) {
                cerrarModalCliente();
            }
        });

        // Cerrar modal con tecla ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                cerrarModalCliente();
            }
        });
    </script>
}