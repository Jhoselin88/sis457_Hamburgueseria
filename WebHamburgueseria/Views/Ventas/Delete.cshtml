@model WebHamburgueseria.Models.Ventas
@{
    ViewData["Title"] = "Eliminar Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card {
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        border-radius: 12px 12px 0 0 !important;
        padding: 20px;
    }

    .page-title {
        color: #2d3436;
        margin-bottom: 5px;
    }

        .page-title i {
            color: #e74c3c;
        }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border: 2px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

        .alert-warning-custom i {
            font-size: 2rem;
            color: #f39c12;
        }

        .alert-warning-custom h5 {
            color: #856404;
            font-weight: 700;
            margin-top: 10px;
        }

        .alert-warning-custom p {
            color: #856404;
            margin-bottom: 0;
        }

    .info-row {
        padding: 15px;
        border-bottom: 1px solid #e9ecef;
        background-color: #f8f9fa;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .info-label i {
            color: #e74c3c;
            width: 20px;
        }

    .info-value {
        color: #636e72;
        font-size: 1rem;
        padding-left: 28px;
    }

    .badge-estado {
        padding: 8px 15px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .badge-activo {
        background: linear-gradient(135deg, #199E37 0%, #06701E 100%);
        color: white;
    }

    .badge-inactivo {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    .btn-eliminar {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(231, 76, 60, 0.3);
    }

        .btn-eliminar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(231, 76, 60, 0.4);
            color: white;
        }

    .btn-cancelar {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 3px 10px rgba(108, 117, 125, 0.3);
    }

        .btn-cancelar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(108, 117, 125, 0.4);
            color: white;
        }

    .transaction-badge {
        background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 20px;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Encabezado -->
    <div class="mb-4">
        <h1 class="h3 page-title">
            Eliminar Venta
        </h1>
        <p class="text-muted mb-0">Confirmar eliminación de la venta</p>
    </div>

    <!-- Contenido -->
    <div class="row">
        <div class="col-md-8 mx-auto">
            <!-- Card con información -->
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        Información de Venta
                    </h4>
                </div>
                <div class="card-body p-0">

                    <!-- Usuario -->
                    <div class="info-row">
                        <div class="info-label">
                            <span>Usuario</span>
                        </div>
                        <div class="info-value">
                            @Html.DisplayFor(model => model.IdUsuarioNavigation.Usuario1)
                        </div>
                    </div>

                    <!-- Cliente -->
                    <div class="info-row">
                        <div class="info-label">
                            <span>Cliente</span>
                        </div>
                        <div class="info-value">
                            @Html.DisplayFor(model => model.IdClienteNavigation.Nombres)
                            @if (!string.IsNullOrEmpty(Model.IdClienteNavigation.CedulaIdentidad))
                            {
                                <span class="text-muted"> - CI: @Model.IdClienteNavigation.CedulaIdentidad</span>
                            }
                        </div>
                    </div>

                    <!-- Usuario Registro -->
                    <div class="info-row">
                        <div class="info-label">
                            <span>Usuario Registro</span>
                        </div>
                        <div class="info-value">
                            @Html.DisplayFor(model => model.UsuarioRegistro)
                        </div>
                    </div>

                    <!-- Fecha Registro -->
                    <div class="info-row">
                        <div class="info-label">
                            <span>Fecha de Registro</span>
                        </div>
                        <div class="info-value">
                            @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
                </div>

                <!-- Botones de acción -->
                <div class="card-footer bg-transparent p-4">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-cancelar">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-eliminar">
                                Eliminar Venta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>